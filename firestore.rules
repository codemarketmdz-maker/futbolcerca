rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(matchId) {
      return signedIn() && get(/databases/$(database)/documents/matches/$(matchId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['Jugador', 'Capitán'];
      allow read: if signedIn();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      // Quien valora a otro suma su valoración al promedio (solo junto al documento de valoración, mismo lote).
      allow update: if signedIn() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingCount', 'punctSum', 'levelSum', 'lastRatingId'])
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.punctSum - resource.data.get('punctSum', 0)
            == getAfter(/databases/$(database)/documents/users/$(uid)/ratings/$(request.resource.data.lastRatingId)).data.punctuality
        && request.resource.data.levelSum - resource.data.get('levelSum', 0)
            == getAfter(/databases/$(database)/documents/users/$(uid)/ratings/$(request.resource.data.lastRatingId)).data.level
        && getAfter(/databases/$(database)/documents/users/$(uid)/ratings/$(request.resource.data.lastRatingId)).data.fromUid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(uid)/ratings/$(request.resource.data.lastRatingId));

      // Historial de partidos del usuario (lo escribe quien lo confirma en el partido).
      match /history/{matchId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && (request.auth.uid == uid || isOwner(matchId))
          && existsAfter(/databases/$(database)/documents/matches/$(matchId)/participants/$(uid));
        allow update: if false;
      }

      // Datos privados (ej. WhatsApp guardado aunque no se muestre): solo el dueño.
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Avisos: cualquiera con sesión puede avisarle a otro; solo el destinatario los lee y marca.
      match /notifications/{nid} {
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
      }

      // Solicitudes para seguirse (la crea quien quiere seguir; responde el destinatario).
      match /friendRequests/{fromUid} {
        allow create: if signedIn() && request.auth.uid == fromUid && fromUid != uid
          && request.resource.data.fromUid == fromUid
          && request.resource.data.status == 'pending';
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'rejected'];
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);
      }

      // Amigos (se crean de a dos, solo al aceptar una solicitud).
      match /friends/{friendUid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow create: if signedIn() && request.resource.data.uid == friendUid && (
          (request.auth.uid == uid
            && get(/databases/$(database)/documents/users/$(uid)/friendRequests/$(friendUid)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/users/$(uid)/friendRequests/$(friendUid)).data.status == 'accepted')
          ||
          (request.auth.uid == friendUid
            && get(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid)).data.status == 'accepted')
        );
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // Valoraciones entre jugadores: solo de partidos ya jugados, una por persona y partido, inmodificables.
      match /ratings/{ratingId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.fromUid == request.auth.uid
          && ratingId == request.resource.data.matchId + '_' + request.auth.uid
          && request.resource.data.punctuality in [1, 2, 3, 4, 5]
          && request.resource.data.level in [1, 2, 3, 4, 5]
          && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.eventAt < request.time
          && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)/participants/$(uid))
          && (isOwner(request.resource.data.matchId)
              || exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)/participants/$(request.auth.uid)));
        allow update, delete: if false;
      }

      // Un amigo te invita a postularte a un partido.
      match /matchInvites/{inviteId} {
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
        allow update: if signedIn() && (request.auth.uid == uid
          || (request.resource.data.fromUid == request.auth.uid && resource.data.fromUid == request.auth.uid
              && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))));
        allow read, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Prueba gratis: un registro por celular, creado una sola vez con la hora del servidor; no se puede editar ni borrar.
    match /devices/{deviceId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.trialStartedAt == request.time;
      allow update, delete: if false;
    }

    // Precios de las licencias (se cambian desde la consola de Firebase): config/license { monthly, quarterly }
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open';

      // El organizador puede editar su partido.
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // Un jugador que acepta una invitación descuenta UNA vacante (y nada más),
      // solo en el mismo lote en que se crea su registro en "participants".
      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playersNeeded', 'status'])
        && request.resource.data.playersNeeded == resource.data.playersNeeded - 1
        && request.resource.data.playersNeeded >= 0
        && ((request.resource.data.playersNeeded > 0 && request.resource.data.status == 'open')
            || (request.resource.data.playersNeeded == 0 && request.resource.data.status == 'full'))
        && !exists(/databases/$(database)/documents/matches/$(matchId)/participants/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/matches/$(matchId)/participants/$(request.auth.uid));

      // Un jugador confirmado que se sale libera UNA vacante, solo junto con borrar su registro en "participants".
      allow update: if signedIn()
        && resource.data.status in ['open', 'full']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playersNeeded', 'status'])
        && request.resource.data.playersNeeded == resource.data.playersNeeded + 1
        && request.resource.data.status == 'open'
        && exists(/databases/$(database)/documents/matches/$(matchId)/participants/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/matches/$(matchId)/participants/$(request.auth.uid));

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Chat del partido: solo organizador y confirmados.
      match /messages/{msgId} {
        allow read: if signedIn() && (isOwner(matchId)
          || exists(/databases/$(database)/documents/matches/$(matchId)/participants/$(request.auth.uid)));
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && (isOwner(matchId)
              || exists(/databases/$(database)/documents/matches/$(matchId)/participants/$(request.auth.uid)));
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // Postulaciones: el jugador se postula, el organizador acepta o rechaza.
      match /applications/{playerUid} {
        allow read: if signedIn() && (request.auth.uid == playerUid || isOwner(matchId));
        allow create: if signedIn() && request.auth.uid == playerUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isOwner(matchId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.status in ['accepted', 'rejected'];
        allow delete: if signedIn() && request.auth.uid == playerUid;
      }

      // Invitaciones: el organizador invita, el jugador acepta o rechaza.
      match /invitations/{playerUid} {
        allow read: if signedIn() && (request.auth.uid == playerUid || isOwner(matchId));
        allow create: if isOwner(matchId)
          && request.resource.data.playerUid == playerUid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if signedIn() && request.auth.uid == playerUid
          && request.resource.data.playerUid == resource.data.playerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'rejected'];
        allow delete: if isOwner(matchId);
      }

      // Jugadores confirmados en el partido (visibles para todos los usuarios con sesión).
      match /participants/{playerUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == playerUid
          && !exists(/databases/$(database)/documents/matches/$(matchId)/participants/$(playerUid))
          && (
            // Caso 1: el organizador acepta una postulación.
            (isOwner(matchId)
              && getAfter(/databases/$(database)/documents/matches/$(matchId)/applications/$(playerUid)).data.status == 'accepted')
            ||
            // Caso 2: el jugador acepta una invitación que existe y está pendiente.
            (request.auth.uid == playerUid
              && get(/databases/$(database)/documents/matches/$(matchId)/invitations/$(playerUid)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/matches/$(matchId)/invitations/$(playerUid)).data.status == 'accepted')
          );
        allow delete: if signedIn() && (request.auth.uid == playerUid || isOwner(matchId));
      }
    }
  }
}
